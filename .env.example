# ==========================================
# ShamshadCodes Website Factory - Environment Configuration
# ==========================================

# 1. Google Sheets Configuration
# Path to service account credentials JSON (Keep this secure! Never commit it.)
GOOGLE_CREDENTIALS_PATH=credentials.json

# Name or ID of your Google Sheet
GOOGLE_SHEET_NAME=sneha real estate agent
GOOGLE_WORKSHEET_NAME=Sheet1

# Column index mappings (1-based index or letter names)
# A: google map link, B: works, C: company name, D: address, E: mobile Number, F: website
# G-K: preserved. L: demo_slug, M: demo_status, N: demo_url, O: demo_generated_at, P: outreach_approved, Q: error_message
COL_MAP_LINK=1
COL_WORKS=2
COL_COMPANY_NAME=3
COL_ADDRESS=4
COL_MOBILE=5
COL_WEBSITE=6
COL_DEMO_SLUG=12
COL_DEMO_STATUS=13
COL_DEMO_URL=14
COL_DEMO_GENERATED_AT=15
COL_OUTREACH_APPROVED=16
COL_ERROR_MESSAGE=17

# 2. AI Engine Configuration
# Supported providers: gemini (recommended), openai, or mock (for testing/dry-runs without an API key)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# 3. Base Deployment URL & Multi-Tenant Routing
# The public Vercel domain pointing to your single Vercel deployment
BASE_DEMO_URL=https://shamshadcodes-website.vercel.app

# 4. GitHub & Vercel Integration (Optional for live deployments)
# If set, worker can commit generated JSONs and verify deployment health
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_REPO=shamshadcodes/website-factory
VERCEL_TOKEN=your_vercel_token_here
VERCEL_PROJECT_ID=your_vercel_project_id_here
VERCEL_TEAM_ID=

# 5. Admin Dashboard Security
# Credentials to access /dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_secure_password_in_production
JWT_SECRET=super_secret_jwt_key_at_least_32_chars_long

# 6. Worker Execution Guardrails
BATCH_SIZE_LIMIT=5
DRY_RUN=false
VERIFY_DEPLOYMENT_TIMEOUT=30
